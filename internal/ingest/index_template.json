{
  "index_patterns": ["aisec-events-*"],
  "template": {
    "settings": {"index": {"refresh_interval": "5s"}},
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "event_id": {"type": "keyword"},
        "tenant_id": {"type": "keyword"},
        "ts": {"type": "date"},
        "trace_id": {"type": "keyword"},
        "channel": {"type": "keyword"},
        "direction": {"type": "keyword"},
        "principal_id": {"type": "keyword"},
        "app_id": {"type": "keyword"},
        "agent_id": {"type": "keyword"},
        "action": {"type": "keyword"},
        "reason_codes": {"type": "keyword"},
        "matched_rules": {"type": "keyword"},
        "policy_version": {"type": "keyword"},
        "risk_score": {"type": "integer"},
        "risk_overrides": {"type": "keyword"},
        "risk_version": {"type": "keyword"},
        "classes": {"properties": {"type": {"type": "keyword"}, "count": {"type": "integer"}, "confidence": {"type": "float"}}},
        "content_hash": {"type": "keyword"},
        "principal_type": {"type": "keyword"},
        "principal_groups": {"type": "keyword"},
        "principal_risk": {"type": "float"},
        "device": {"type": "keyword"},
        "account_context": {"type": "keyword"},
        "sanction": {"type": "keyword"},
        "region": {"type": "keyword"},
        "trains_on_data": {"type": "boolean"},
        "sensitivity": {"type": "keyword"},
        "injection_score": {"type": "float"},
        "jailbreak_score": {"type": "float"},
        "exfil_score": {"type": "float"},
        "volume_ratio": {"type": "float"},
        "tokens": {"type": "integer"},
        "agent_tool": {"type": "keyword"},
        "tool_risk": {"type": "keyword"},
        "agent_action": {"type": "keyword"},
        "agent_registered": {"type": "boolean"},
        "session_injection_max": {"type": "float"},
        "hitl_available": {"type": "boolean"},
        "snippet": {"type": "text"}
      }
    }
  }
}
